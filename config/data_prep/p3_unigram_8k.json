{
  "tokenizer": {
    "type": "unigram",
    "vocab_size": 8192,
    "character_coverage": 0.9995,
    "max_corpus_mb": 600,
    "model_path": "data/fast/mixed_10t_60f_30w_unigram8k_tokenizer.model"
  },
  "datasets": [
    {
      "name": "wikitext",
      "path": "/mnt/d/Dev/data/wikitext-103-raw/train_normalized.txt",
      "format": "text",
      "weight": 0.1,
      "delimiter": "\n\n",
      "min_length": 50
    },
    {
      "name": "tinystories",
      "path": "/mnt/d/Dev/data/tinystories-gpt4-clean/train.txt",
      "format": "text",
      "weight": 0.05,
      "delimiter": "\n",
      "min_length": 20
    },
    {
      "name": "openwebtext",
      "path": "/mnt/d/Dev/data/openwebtext/train.txt",
      "format": "text",
      "weight": 0.5,
      "delimiter": "\n\n",
      "min_length": 50
    },
    {
      "name": "fineweb",
      "path": "/mnt/d/Dev/data/fineweb-edu-raw/sample-100BT",
      "format": "text",
      "weight": 0.35,
      "delimiter": "\n\n",
      "min_length": 50
    }
  ],
  "mixing": {
    "strategy": "interleave",
    "source_ratios": {"tinystories": 0.05, "openwebtext": 0.5, "fineweb": 0.35, "wikitext": 0.1},
    "seed": 42
  },
  "splits": {
    "train": 0.9,
    "val": 0.1,
    "test": 0.0,
    "shuffle": true,
    "stratified": true,
    "seed": 42
  },
  "output": {
    "dir": "data/fast",
    "prefix": "mixed_5ts_50owt_35fw_10wt_unigram8k",
    "save_stats": true,
    "save_manifest": true,
    "eos_token_id": 1
  }
}
